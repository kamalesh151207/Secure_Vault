        "body": {
          "mode": "raw",
          "raw": "{\n  \"payload\": \"UNION SELECT username, encrypted_password FROM users--\",\n  \"simulateParameterization\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/test/inject",
          "host": ["{{baseUrl}}"],
          "path": ["test", "inject"]
        }
      }
